# ALL MDM — copie para .env (ou cadastre no Portainer) e ajuste os valores.

# Versão da imagem (ghcr.io/allexandercaneschi/all-mdm). "latest" = última publicada
IMAGE_TAG=latest

# Banco PostgreSQL externo
SQL_HOST=172.16.0.242
SQL_PORT=5432
SQL_BASE=mdm
SQL_USER=postgres
SQL_PASS=troque-esta-senha

# Domínio público do painel (o proxy reverso entrega HTTPS e encaminha para a porta 8800)
BASE_DOMAIN=mdm.alltecnologias.com.br

# IP(s) do proxy reverso, separados por vírgula (opcional, para logar o IP real dos celulares)
PROXY_ADDRESSES=

# E-mail do usuário admin do painel (usado no "Esqueceu a senha?")
ADMIN_EMAIL=alltecnologias@alltecnologias.com.br

# Envio de e-mail (recuperação de senha). Porta 465 = SSL direto.
# A senha NÃO vai para o repositório: cadastre só no .env do servidor ou no Portainer.
SMTP_HOST=mail.alltecnologias.com.br
SMTP_PORT=465
SMTP_SSL=1
SMTP_STARTTLS=0
SMTP_USER=noreply@alltecnologias.com.br
SMTP_PASS=
SMTP_FROM=noreply@alltecnologias.com.br

# Segredo compartilhado entre painel e agente Android.
# Troque por um valor longo e aleatório e use O MESMO no secret ALL_MDM_SHARED_SECRET
# do repositório all-mdm-android. Gere com: openssl rand -hex 24
SHARED_SECRET=troque-este-segredo

# Ligue (true) só para regravar as configurações depois de mudar variáveis; depois volte a deixar vazio
FORCE_RECONFIGURE=
